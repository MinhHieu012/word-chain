{
  "name": "word-chain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch src/server/index.ts",
    "build": "tsc && vite build",
    "start": "node src/server/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "build-dict": "node scripts/build-dict.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
